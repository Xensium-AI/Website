# XENSIUM AI website — environment variables
# Copy to .env.local for local overrides. Placeholder/empty values only in
# this file — never commit real secrets.

# Public base URL of the deployed site, used to resolve absolute Open Graph
# and social URLs. Leave empty locally (the app falls back to
# http://localhost:3000). In Vercel, set it to the deployment's real domain,
# e.g. https://www.your-domain.com — no trailing slash.
NEXT_PUBLIC_SITE_URL=

# --- Future integrations (not connected yet) ---
# Phone, calendar, and the contact-form backend are placeholders today and
# need no variables. When a backend/email service is added, its credentials
# go in .env.local (gitignored) WITHOUT the NEXT_PUBLIC_ prefix, since any
# NEXT_PUBLIC_ value is embedded in the browser bundle and is world-readable:
# EMAIL_SERVICE_API_KEY=
